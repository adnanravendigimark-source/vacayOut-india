# Copy to .env.local (never commit real values).

# Neon Postgres — use the pooled connection string (host contains "-pooler").
DATABASE_URL=

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Public site URL (used for canonical URLs and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob (image uploads). Without it, local dev stores images in public/uploads.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/publish-jobs (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=

# Phase 2+ (research and AI chat)
OPENAI_API_KEY=
# Optional research settings (defaults shown)
# OPENAI_RESEARCH_MODEL=gpt-5.5
# OPENAI_CHECK_MODEL=gpt-5.4-mini
# OPENAI_DRAFT_MODEL=gpt-5.5
# RESEARCH_MONTHLY_BUDGET_USD=20     # starting budget; admins can change it on /admin/research
# RESEARCH_RUN_RESERVE_USD=1.5       # set aside per run while it runs
# RESEARCH_SEARCH_CALL_USD=0.01
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare   # optional AI illustrations
# OPENAI_IMAGE_COST_USD=0.2
# GENERATION_STALL_MINUTES=20         # show Resume / auto-resume after this long without progress
# OPENAI_BACKGROUND_WAIT_MS=150000    # how long one step waits on a background research request before checking back
# RESEARCH_PRICES={"gpt-5.5":{"in":5,"cached":0.5,"out":30}}

# Phase 4 — chat and traveller accounts
# Email (verification links) via Resend: https://resend.com — EMAIL_FROM must use a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM="VacayOut <hello@vacayout.in>"
# "Continue with Google" (hidden until both are set). Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: Upstash Redis for rate limits (otherwise the database is used)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional chat settings (defaults shown)
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_ROUTE_MODEL=gpt-5.4-mini
# OPENAI_CHAT_RESEARCH_MODEL=gpt-5.4-mini
# CHAT_FREE_MESSAGES=5
# CHAT_DAILY_MESSAGES=80
# CHAT_RESEARCH_PER_DAY_ANON=10
# CHAT_RESEARCH_PER_DAY=25
# CHAT_MONTHLY_BUDGET_USD=30   # starting value; admins can change it on /admin/chat

# Phase 5 — maps, booking, monitoring (all optional)
# Map tiles (default: OpenStreetMap's public tiles; switch to a tile provider for heavy traffic)
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Affiliate IDs — links work without them; with them, pages show a commission disclosure
BOOKING_AFFILIATE_ID=
GETYOURGUIDE_PARTNER_ID=
# BOOKING_LINKS=off   # hide all booking links

# Homepage sample content (design only). Fills homepage sections that have no published
# data with clearly tagged sample destinations. Default: on in development, OFF in production.
# HOMEPAGE_SAMPLE_CONTENT=0
