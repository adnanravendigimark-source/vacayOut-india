{
  "name": "vacayout-india",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mts",
    "admin:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-admin.mts",
    "test:db": "tsx --env-file-if-exists=.env.test --conditions=react-server --test --test-concurrency=1 src/**/*.int.test.mts",
    "content:check": "tsx --conditions=react-server scripts/check-content.mts",
    "seed:content": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/seed-content.mts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@vercel/blob": "2.8.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "leaflet": "1.9.4",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "workflow": "5.2.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
